# 复制为 .env 后填写。只用测试专用钱包！永远不要把 .env 提交到 Git。
# 同一个私钥可以同时用于源链 / Lasna / 目标链（地址相同，各链分别要有余额）。
PRIVATE_KEY=0x...

# 源链 & 目标链（默认都用 Ethereum Sepolia，最简单；也可换成 Base Sepolia / Unichain Sepolia）
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ORIGIN_CHAIN_ID=11155111
DEST_CHAIN_ID=11155111
# 目标链的 Callback Proxy（见 docs/cheatsheet.md）：Sepolia / Base Sepolia / Unichain Sepolia 三选一
CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4

# Reactive 侧
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# 以下三项由部署脚本依次产出，按顺序填回
ORIGIN_ADDR=
REACTIVE_ADDR=
CALLBACK_ADDR=

# Phase A 教学模拟价差路径。金额写 wei 整数，不要写 "0.002 ether"（Foundry 会把整份 .env 丢掉）。
# spread-lab.ps1 只填下面三个地址，不覆盖上面的 ORIGIN / REACTIVE / CALLBACK，也不覆盖 D5_*。
# SPREAD_AMM_ADDR=
# SPREAD_REACTIVE_ADDR=
# SPREAD_LEDGER_ADDR=
# SPREAD_REACTIVE_FUND=100000000000000000
# SPREAD_LEDGER_FUND=2000000000000000
# SPREAD_THRESHOLD_BPS=100
# SPREAD_MAX_RECORDS=5

# 恋爱脑清醒日历（赛道 2 提交项）。calendar-lab.ps1 只写 CALENDAR_* 行。
# 录 demo 建议 CALENDAR_WINDOW=300（5 分钟）；正式约 3 天 = 259200。
# CALENDAR_ADDR=
# CALENDAR_REACTIVE_ADDR=
# CALENDAR_FUND=1000000000000000
# CALENDAR_REACTIVE_FUND=50000000000000000
# CALENDAR_WINDOW=300
# CALENDAR_CRON_CAP=8
# CALENDAR_DEMO_THREAD_ID=
